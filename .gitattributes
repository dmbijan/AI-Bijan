* text=auto eol=lf

*.blade.php diff=html
*.css diff=css
*.html diff=html
*.md diff=markdown
*.php diff=php

# Windows script kekal CRLF (jika ditukar, PowerShell boleh rosak)
*.ps1   text eol=crlf
*.bat   text eol=crlf
*.cmd   text eol=crlf

# Fail binari
*.png   binary
*.jpg   binary
*.jpeg  binary
*.gif   binary
*.ico   binary
*.pdf   binary
*.zip   binary
*.sqlite binary
*.ttf   binary
*.woff  binary
*.woff2 binary

# Fail yang dijana — jangan gabung automatik
composer.lock  merge=binary
package-lock.json merge=binary

/.github export-ignore
CHANGELOG.md export-ignore
.styleci.yml export-ignore
