{
  "name": "aibijan-mograph-starter",
  "version": "1.7.0",
  "private": true,
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "remotion studio src/index.ts",
    "typecheck": "tsc --noEmit",
    "check-env": "node scripts/check-env.mjs",
    "prepare-vo": "node scripts/prepare-voiceover.mjs",
    "align": "node scripts/align.mjs",
    "brand": "node scripts/brand.mjs",
    "score": "node scripts/score-bed.mjs",
    "auto-duck": "node scripts/auto-duck.mjs",
    "audio-qc": "node scripts/audio-qc.mjs",
    "render": "node scripts/render-safe.mjs",
    "stills": "node scripts/stills.mjs",
    "kit-preview": "node scripts/stills.mjs --comp=KitGallery out/kit 3.5 7.5 11.5 15.5 19.5 23.5 27.5",
    "style-preview": "node scripts/stills.mjs --comp=StyleGallery out/styles 2.6 3.6 6.6 7.6 10.6 11.6 14.6 15.6 18.6 19.6 22.6 23.6",
    "style-sfx": "node scripts/style-sound.mjs sfx",
    "style-score": "node scripts/style-sound.mjs score"
  },
  "dependencies": {
    "@remotion/bundler": "4.0.534",
    "@remotion/cli": "4.0.534",
    "@remotion/renderer": "4.0.534",
    "react": "19.1.1",
    "react-dom": "19.1.1",
    "remotion": "4.0.534"
  },
  "devDependencies": {
    "@types/react": "19.1.10",
    "@types/react-dom": "19.1.7",
    "typescript": "5.9.2"
  }
}
