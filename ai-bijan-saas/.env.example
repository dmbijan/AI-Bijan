APP_NAME="AI BIJAN SaaS"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

APP_LOCALE=ms
APP_FALLBACK_LOCALE=ms
APP_FAKER_LOCALE=en_MY

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=ai_bijan
# DB_USERNAME=root
# DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="noreply@aibijan.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# ============================================
# AI BIJAN SaaS — Configuration Fasa 1
# ============================================

# Percubaan hari (trial)
AIBIJAN_TRIAL_DAYS=14

# Upload had (KB)
AIBIJAN_UPLOAD_MAX_KB=10240

# Upload mimes dibenarkan
AIBIJAN_UPLOAD_MIMES="pdf,png,jpg,jpeg,webp,csv,xlsx,docx,txt"

# Super Admin kata laluan (WAJIB ubah selepas pemasangan!)
# ⚠️ Jangan commit kata laluan sebenar. Guna `php artisan aibijan:admin` atau
#    tetapkan nilai kukuh dalam `.env` tempatan anda.
ADMIN_PASSWORD=

# ============================================
# AI Provider (B-Brain Hub — Fasa 6)
# ============================================

# OpenRouter API key (provider awal)
OPENROUTER_API_KEY=

# Model lalai untuk setiap tugas AI
AI_MODEL_CHAT=qwen/qwen-2.5-72b-instruct
AI_MODEL_SUMMARIZE=qwen/qwen-2.5-turbo
AI_MODEL_CLASSIFY=gpt-4o-mini

# Had token per permintaan (max 4096)
AI_MAX_TOKENS=1024
AI_TEMPERATURE=0.7
AI_TIMEOUT_MS=30000

# Budget harian per tenant (USD)
AI_BUDGET_DAILY=5.00
AI_BUDGET_MONTHLY=100.00

# Redaksi PII sebelum hantar ke provider
AI_REDACT_PII=true

# Allowlist model yang boleh digunakan
AI_ALLOWED_MODELS="qwen/qwen-2.5-72b-instruct,gpt-4o-mini,claude-haiku-3.5"

# Circuit breaker — bilangan kegagalan sebelum trip
AI_CIRCUIT_BREAKER_THRESHOLD=5
AI_CIRCUIT_BREAKER_RESET_SECONDS=60

# ============================================
# Payment Gateway (Fasa 3+)
# ============================================

# Billplz
BILLPLZ_API_KEY=
BILLPLZ_COLLECTION_ID=

# ToyyibPay
TOYYIBPAY_API_KEY=
TOYYIBPAY_CATEGORY_CODE=

# iPay88
IPAY88_API_KEY=
IPAY88_LOCKKEY=

# Stripe
STRIPE_KEY=
STRIPE_SECRET=
STRIPE_WEBHOOK_SECRET=

# DuitNow QR (via penyedia)
DUITNOW_QR_MERCHANT_ID=

# ============================================
# Messaging & Notification (Fasa 5+)
# ============================================

# WhatsApp Cloud API
WHATSAPP_BUSINESS_ACCOUNT_ID=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_VERIFY_TOKEN=
WHATSAPP_ACCESS_TOKEN=

# Telegram Bot
TELEGRAM_BOT_TOKEN=
TELEGRAM_BOT_USERNAME=

# SMS Gateway
SMS_PROVIDER=binarygo
SMS_API_KEY=
SMS_SENDER_ID=AI-BIJAN

# Push Notifications
PUSHER_APP_KEY=
PUSHER_APP_SECRET=
PUSHER_APP_CLUSTER=mt1

# ============================================
# Storage & CDN
# ============================================

# Cloudflare R2 / AWS S3
STORAGE_DISK=s3
AWS_S3_BUCKET=ai-bijan-storage
AWS_S3_ENDPOINT=https://account-id.r2.cloudflarestorage.com
AWS_S3_ACCESS_KEY_ID=
AWS_S3_SECRET_ACCESS_KEY=
AWS_S3_REGION=auto

# Disk fail tempatan (cPanel)
LOCAL_STORAGE_PATH=storage/app/private

# ============================================
# Search & Analytics (Fasa 4+)
# ============================================

# Meilisearch
MEILISEARCH_HOST=http://127.0.0.1:7700
MEILISEARCH_MASTER_KEY=

# Qdrant (Vector Search — RAG)
QDRANT_URL=http://127.0.0.1:6333
QDRANT_API_KEY=

# Monitoring
SENTRY_LARAVEL_DSN=
SENTRY_TRACES_SAMPLE_RATE=1.0

# Laravel Pulse
PULSE_ENABLED=true
PULSE_RETENTION_DAYS=30

# Uptime check URL
UPTIME_CHECK_URL=https://uptime.example.com/verify

# ============================================
# Security
# ============================================

# CSRF protection
CSRF_COOKIE_SECURE=true
CSRF_HTTP_ONLY=true
CSRF_SAMESITE=lax

# Rate limiting
RATE_LIMIT_AUTH=5|1
RATE_LIMIT_API=60|1
RATE_LIMIT_WEB=240|1

# Session security
SESSION_SECURE=true
SESSION_EXPIRE_ON_CLOSE=false

# Two Factor Authentication
TOTP_DIGITS=6
TOTP_PERIOD=30
TOTP_WINDOW=1

# ============================================
# ERPNext — DISABLED (Stand-alone system)
# ============================================

ERP_NEXT_ENABLED=false
ERP_NEXT_BASE_URL=
ERP_NEXT_API_KEY=
ERP_NEXT_API_SECRET=
ERP_NEXT_SITE_NAME=

# ============================================
# LHDN MyInvois (Fasa 4+ — Malaysia)
# ============================================

MYINVOIS_CLIENT_ID=
MYINVOIS_CLIENT_SECRET=
MYINVOIS_SANDBOX=true
MYINVOIS_REDIRECT_URI=https://aibijan.com/myinvois/callback

# ============================================
# Logging & Debugging
# ============================================

# Log level untuk production
LOG_LEVEL_PROD=warning

# Query logging (disable in production!)
QUERY_LOG_ENABLED=false

# SQL logging threshold (ms)
SQL_LOG_THRESHOLD=100
