APP_NAME="AI BIJAN SaaS"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000
OPENBOT_URL=
SANCTUM_STATEFUL_DOMAINS=localhost,localhost:3000,localhost:8000,127.0.0.1,127.0.0.1:8000,127.0.0.1:8145,::1

APP_LOCALE=ms
APP_FALLBACK_LOCALE=ms
APP_FAKER_LOCALE=en_MY

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=ai_bijan
# DB_USERNAME=root
# DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="noreply@aibijan.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# ============================================
# AI BIJAN SaaS — Configuration Fasa 1
# ============================================

# Percubaan hari (trial)
AIBIJAN_TRIAL_DAYS=14

# Upload had (KB)
AIBIJAN_UPLOAD_MAX_KB=10240

# Upload mimes dibenarkan
AIBIJAN_UPLOAD_MIMES="pdf,png,jpg,jpeg,webp,csv,xlsx,docx,txt"

# Super Admin kata laluan (WAJIB ubah selepas pemasangan!)
# ⚠️ Jangan commit kata laluan sebenar. Guna `php artisan aibijan:admin` atau
#    tetapkan nilai kukuh dalam `.env` tempatan anda.
ADMIN_PASSWORD=

# ============================================
# AI Provider — AIGateway (satu pintu untuk SEMUA model)
# ============================================
# ⚠️ Kunci HANYA dibaca pelayan. JANGAN dedahkan ke frontend.
# Semua modul mesti panggil GatewayService::call() — tiada panggilan provider terus.

# Upstream provider (reseller)
AI_GATEWAY_URL=https://serveras.click/v1
AI_GATEWAY_KEY=

# ⚠️ WAJIB false dalam dev/CI — mod simulasi (tiada kos, tiada panggilan rangkaian).
# Set true HANYA pada produksi dengan kunci sah.
AI_GATEWAY_LIVE=false

# Prompt injection guard (PromptGuard) — imbasan input & output
AI_GATEWAY_SCAN_INPUT=true
AI_GATEWAY_SCAN_OUTPUT=true
AI_GATEWAY_BLOCK_THRESHOLD=1

# Timeout permintaan ke provider (saat)
AI_GATEWAY_TIMEOUT=120

# Embedding / RAG (hash-v1 = padanan perkataan, BUKAN semantik)
AI_EMBEDDING_MODEL=hash-v1
AI_EMBEDDING_DIMENSIONS=256
AI_EMBEDDING_CHUNK_SIZE=800
AI_EMBEDDING_CHUNK_OVERLAP=100

# Routing model diurus dalam jadual `ai_model_catalog` (disemai AiModelCatalogSeeder),
# BUKAN dalam .env. Kunci lama AI_MODEL_CHAT/AI_ALLOWED_MODELS tidak lagi digunakan.

# ============================================
# Payment Gateway (⚠️ BELUM DIKODKAN — lihat docs/TODO.md P0-3)
# ============================================
# Kunci di bawah disediakan untuk modul bayaran yang belum wujud.
# Tiada kelas Billplz/ToyyibPay dalam kod pada 26 Okt 2026.
# Bayaran kini direkod MANUAL melalui invoicing/invoices/{id}/payment.

# Billplz
BILLPLZ_API_KEY=
BILLPLZ_COLLECTION_ID=

# ToyyibPay
TOYYIBPAY_API_KEY=
TOYYIBPAY_CATEGORY_CODE=

# iPay88
IPAY88_API_KEY=
IPAY88_LOCKKEY=

# Stripe
STRIPE_KEY=
STRIPE_SECRET=
STRIPE_WEBHOOK_SECRET=

# DuitNow QR (via penyedia)
DUITNOW_QR_MERCHANT_ID=

# ============================================
# Messaging & Notification (Fasa 5+)
# ============================================

# WhatsApp Cloud API
WHATSAPP_BUSINESS_ACCOUNT_ID=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_VERIFY_TOKEN=
WHATSAPP_ACCESS_TOKEN=

# Telegram Bot
TELEGRAM_BOT_TOKEN=
TELEGRAM_BOT_USERNAME=

# SMS Gateway
SMS_PROVIDER=binarygo
SMS_API_KEY=
SMS_SENDER_ID=AI-BIJAN

# Push Notifications
PUSHER_APP_KEY=
PUSHER_APP_SECRET=
PUSHER_APP_CLUSTER=mt1

# ============================================
# Storage & CDN
# ============================================

# Cloudflare R2 / AWS S3
STORAGE_DISK=s3
AWS_S3_BUCKET=ai-bijan-storage
AWS_S3_ENDPOINT=https://account-id.r2.cloudflarestorage.com
AWS_S3_ACCESS_KEY_ID=
AWS_S3_SECRET_ACCESS_KEY=
AWS_S3_REGION=auto

# Disk fail tempatan (cPanel)
LOCAL_STORAGE_PATH=storage/app/private

# ============================================
# Search & Analytics (Fasa 4+)
# ============================================

# Meilisearch
MEILISEARCH_HOST=http://127.0.0.1:7700
MEILISEARCH_MASTER_KEY=

# Qdrant (Vector Search — RAG)
QDRANT_URL=http://127.0.0.1:6333
QDRANT_API_KEY=

# Monitoring
SENTRY_LARAVEL_DSN=
SENTRY_TRACES_SAMPLE_RATE=1.0

# Laravel Pulse
PULSE_ENABLED=true
PULSE_RETENTION_DAYS=30

# Uptime check URL
UPTIME_CHECK_URL=https://uptime.example.com/verify

# ============================================
# Security
# ============================================

# CSRF protection
CSRF_COOKIE_SECURE=true
CSRF_HTTP_ONLY=true
CSRF_SAMESITE=lax

# Rate limiting
RATE_LIMIT_AUTH=5|1
RATE_LIMIT_API=60|1
RATE_LIMIT_WEB=240|1

# Session security
SESSION_SECURE=true
SESSION_EXPIRE_ON_CLOSE=false

# Two Factor Authentication
TOTP_DIGITS=6
TOTP_PERIOD=30
TOTP_WINDOW=1

# ============================================
# ERPNext — DISABLED (Stand-alone system)
# ============================================

ERP_NEXT_ENABLED=false
ERP_NEXT_BASE_URL=
ERP_NEXT_API_KEY=
ERP_NEXT_API_SECRET=
ERP_NEXT_SITE_NAME=

# ============================================
# LHDN MyInvois (Fasa 4+ — Malaysia)
# ============================================

MYINVOIS_CLIENT_ID=
MYINVOIS_CLIENT_SECRET=
MYINVOIS_SANDBOX=true
MYINVOIS_REDIRECT_URI=https://aibijan.com/myinvois/callback

# ============================================
# Logging & Debugging
# ============================================

# Log level untuk production
LOG_LEVEL_PROD=warning

# Query logging (disable in production!)
QUERY_LOG_ENABLED=false

# SQL logging threshold (ms)
SQL_LOG_THRESHOLD=100

# ============================================
# CHIP Collect — Langganan (Billing)
# ============================================
# ⚠️ Kunci HANYA di pelayan. Jangan dedahkan ke frontend/log.
# Dapatkan dari https://portal.chip-in.asia → Developers → API Keys
CHIP_BASE_URL=https://gate.chip-in.asia/api/v1
CHIP_API_KEY=
CHIP_BRAND_ID=
# Kunci awam CHIP (PEM) untuk sahkan tandatangan webhook RSA-SHA256.
# TANPA ini, SEMUA webhook ditolak (pembayaran tidak akan diaktifkan).
CHIP_WEBHOOK_PUBLIC_KEY=
CHIP_WEBHOOK_TOLERANCE=300
CHIP_TIMEOUT=30
CHIP_LIVE=false

# ============================================
# Reseller — komisen berulang
# ============================================
# Model: RM388 langganan + pakej token AI (WAJIB) setiap bulan
#   → reseller RM100/bulan dari LANGGANAN sahaja (tidak berkait token)
#   → platform simpan RM288 dari langganan + 100% hasil token
#
# ⚠️ Kos platform BELUM DIKIRA. Jangan dakwa margin sebelum:
#   1. Harga pembekal token (serveras.click) disahkan
#   2. Dashboard kos AI per pelanggan dibina (ai_usage_events)
# ⚠️ Jangan jual pakej token di bawah kos pembekal.
RESELLER_COMMISSION=100
# Kosong = selagi pelanggan langgan (tiada had). Set 24 untuk hadkan.
RESELLER_COMMISSION_MONTHS=
RESELLER_CAP_PCT=50
RESELLER_MATANG_HARI=30
RESELLER_MIN_PAYOUT=100
RESELLER_COOKIE_DAYS=90

# ============================================
# Pakej token AI — WAJIB dipilih semasa langganan
# ============================================
# ⚠️ HARGA DISAHKAN 27 Okt 2026. Margin jual 90.9% seragam.
# *_COST_* = harga kita BELI dari pembekal (jangan dedahkan ke pelanggan).
# Pakej pelanggan mesti dibeli dari pakej pembekal yang cukup besar (buffer).
TOKEN_PACKAGE_60M=55
TOKEN_COST_60M=5
TOKEN_PACKAGE_130M=88
TOKEN_COST_130M=8
TOKEN_PACKAGE_180M=110
TOKEN_COST_180M=10
TOKEN_PACKAGE_1B=550
TOKEN_COST_1B=50
TOKEN_PACKAGE_2B=1100
TOKEN_COST_2B=100

# ============================================
# URL redirect selepas bayaran
# ============================================
BILLING_SUCCESS_URL=/admin/tetapan?bayaran=berjaya
BILLING_FAILURE_URL=/admin/tetapan?bayaran=gagal
BILLING_REGISTER_URL=/daftar
