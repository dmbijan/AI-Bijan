# ============================================================
# AI BIJAN — .gitignore (akar repo)
# ============================================================

# --- Rahsia: JANGAN sekali-kali commit ---
.env
.env.*
!.env.example
*.pem
*.key
!storage/*.key

# --- Kebergantungan (dipasang semula melalui composer/npm) ---
/vendor/
/node_modules/

# --- Hasil binaan ---
/public/build/
/public/hot
/public/storage
/public/fonts-manifest.dev.json

# --- Cache & log ---
*.log
/storage/framework/cache/data/*
/storage/framework/sessions/*
/storage/framework/views/*
/storage/logs/*
/bootstrap/cache/*.php
.phpunit.result.cache
.phpunit.cache/
/.phpactor.json

# --- Sandaran tempanan (besar, tidak perlu dalam repo) ---
/backups/
/backups

# --- Pangkalan data SQLite (data pembangunan) ---
*.sqlite
*.sqlite3
*.sqlite-journal
*.sqlite-shm
*.sqlite-wal
/database/*.sqlite
/database/*.sqlite-journal
/database/*.sqlite-shm
/database/*.sqlite-wal

# --- Folder tidak di-push (dipilih pengguna) ---
/b-pos-system/

# --- Folder legasi (struktur lama sebelum konsolidasi ke akar repo) ---
/ai-bijan-saas/

# --- Editor / OS / IDE ---
/.vscode/
/.idea/
/.nova/
/.zed/
/.cursor/
/.codex
/.DS_Store
Thumbs.db

# --- Sampah sementara ---
_ide_helper.php
/up*.txt
down*.txt
*.bak
routes_dump.json
ujian-*.txt
.pinttmp/
/storage/pint-k/
/storage/test-suite.log
/storage/framework/testing/

# --- Horizen lain ---
Homestead.json
Homestead.yaml
/auth.json
