# ============================================================
# AI BIJAN — .gitignore (root repo)
# ============================================================

# --- Rahsia: JANGAN sekali-kali commit ---
.env
.env.*
!.env.example
*.pem
*.key
!storage/*.key

# --- Kebergantungan (dipasang semula melalui composer/npm) ---
vendor/
node_modules/

# --- Hasil binaan ---
public/build/
public/hot
public/storage

# --- Cache & log ---
*.log
storage/framework/cache/data/*
storage/framework/sessions/*
storage/framework/views/*
storage/logs/*
bootstrap/cache/*.php
.phpunit.result.cache
.phpunit.cache/

# --- Sandaran tempatan (besar, tidak perlu dalam repo) ---
backups/

# --- Pangkalan data SQLite (data pembangunan) ---
*.sqlite
*.sqlite3

# --- Folder tidak di-push (diputuskan pengguna) ---
b-pos-system/

# --- Editor / OS ---
.vscode/
.idea/
.nova/
.zed/
.DS_Store
Thumbs.db

# --- Sampah sementara ---
_ide_helper.php
# Peraturan tambahan aplikasi
*.log
.DS_Store
.env
.env.backup
.env.production
.phpactor.json
.phpunit.result.cache
/.codex
/.cursor/
/.idea
/.nova
/.phpunit.cache
/.vscode
/.zed
/auth.json
/node_modules
/public/build
/public/fonts-manifest.dev.json
/public/hot
/public/storage
/storage/*.key
/storage/pail
/vendor
_ide_helper.php
Homestead.json
Homestead.yaml
Thumbs.db

# Pangkalan data tempatan — JANGAN commit (data pelanggan)
/database/*.sqlite
/database/*.sqlite-journal
/database/*.sqlite-shm
/database/*.sqlite-wal

# Fail kerja / output sementara
/up*.txt
down*.txt
*.bak
routes_dump.json

# Arkib sandaran besar
/backups
